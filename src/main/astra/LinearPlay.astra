
import mams.web.HttpResponse;
import mams.JSONConverter;
import mams.JSONBuilder;
import astra.jena.*;
import com.fasterxml.jackson.databind.JsonNode;

agent LinearPlay extends Player {
    rule $knowledgeStoreGame.read(string url) : game(string id, string role, string opponent) & strings.contains(url, "result") {
        //TODO Part 3
        // knowledgeStoreGame.displayModel();
        -game(id, role, opponent);
        list agents = S.getAgentsOfType("Better");
        agents = agents + S.getAgentsOfType("Opponent");
        agents = agents + S.getAgentsOfType("LinearPlay");
        foreach(ttt.TicTacToeResult(url, string agent_url)){
            if(strings.contains(agent_url, "http://localhost:8083/tic-tac-toe#OPlayerRole"))
            {
                send(inform, "main", winner("OPlayerRole"));
                int i = list_count(agents)-1;
                while(i>=0)
                {
                    send(inform, at_index(agents, i, string), winner("OPlayerRole"));
                    i = i-1;
                }
            }
            else if(strings.contains(agent_url, "http://localhost:8083/tic-tac-toe#XPlayerRole"))
            {
                send(inform, "main", winner("XPlayerRole"));
                int i = list_count(agents)-1;
                while(i>=0)
                {
                    send(inform, at_index(agents, i, string), winner("XPlayerRole"));
                    i = i-1;
                }
            }
            else{
                send(inform, "main", winner("Draw"));
                int i = list_count(agents)-1;
                while(i>=0)
                {
                    send(inform, at_index(agents, i, string), winner("Draw"));
                    i = i-1;
                }
            }
            !clear_knowledge();
            
            system.sleep(500);
            !gameReset();
            !get_index_page();
        }
         
    }

    rule $knowledgeStoreGame.read(string url) : game(string id, string role, string opponent) & agent_attributes(string agentid, string uri) {
        //TODO Part 3
        
        !form_actions(url);
        !link_actions(url);
        system.sleep(1000);

        if(link_actions(string linkURL))
        {
            if(strings.contains(linkURL, "/result"))
            {
                knowledgeStoreGame.getKnowledge(linkURL, "JSON-LD");
            }
            else{
                if(form_actions(string form_url, string http_method, list required_actions) & strings.contains(form_url, "Square"))
                {
                    !move();
                    
                }
                // for a total of 7 turns even if X wins, the linkURL is only http://localhost:8083/ instead of http://localhost:8083/result/...
                // So i force it below. 
                else{
                    
                        string newURL = "http://localhost:8083/result/" + id;
                        knowledgeStoreGame.getKnowledge(newURL, "JSON-LD");
                }
            }
        }

    }

    
    // using linear strategy
    rule +!move() : free("11") & game(string id, string role, string opponent) {
        if(form_actions(string form_url, string http_method, list required_actions))
        {
            string c = "11";
            foreach(form_actions(string anyForm, string method_name, list any_list) & strings.contains(anyForm, "Square" + c) ) 
            {
                form_url = "http://localhost:8083/Square"+ c + "/" + id ;
                console.println(role + " Played " + c);
                !makePlay(form_url, c);
            }
        }
    } 

