    rule +!makePlay(string url, string a): agent_attributes(string agentid, string uri) & game(string id, string role, string opponent)
    {
        JsonNode bodyJson = builder.createObject();
        builder.addProperty(bodyJson, agentid, uri);
        string bodyStr = builder.toJsonString(bodyJson);
        MAMSAgent::!put(url, bodyStr, HttpResponse response);
        -turn(true);
        +turn(false);
        +takenLocations(role, a);
        send(inform, opponent, takenLocations(role, a));
        send(inform, opponent, turn(true));
    }

