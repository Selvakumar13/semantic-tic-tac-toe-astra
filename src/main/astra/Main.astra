import mams.web.HttpResponse;
import mams.JSONConverter;
import mams.JSONBuilder;
import astra.jena.*;
import com.fasterxml.jackson.databind.JsonNode;
 

agent Main extends Shared {

    //Apache Jena Knowledge Stores
    module KnowledgeStore knowledgeStore; //To store knowledge about the players
    module astra.lang.custom.RandomInRange random;

    types players {
        formula player(string, string); //Agent role, agent URL: in my system
       
    }
    
    initial api_index_url("http://localhost:8083/");

    constant string XPlayerRole = "XPlayerRole";
    constant string OPlayerRole = "OPlayerRole";

    rule +!main(list l) : api_index_url(string game_url) {

        messaging.installService("mams", "mams.messaging.MAMSMessageService");

        MAMSAgent::!setup();
        MAMSAgent::!created("base");
        IntegratedInbox::!created("inbox");
        list strategies = ["Opponent", "LinearPlay", "Better"];
        

        // I created the random module a few labs ago, and I am reusing it to get random integer between
        int n = random.randomIntBetween(2,7);
        int i = 1;
        console.println("Number of players: " + n);
        // created match states between different players, the games will run for each combination of players
        // once all matches are done, score for each player will be printed
        while (i <= n) {
            int j = i + 1;
            while (j <= n) {
                +agentSelection("Agent"+i , "Agent"+j);
                j++;
            }
            !shuffle(strategies, list l2, 3);
            console.println("Agent"+i + " is using strategy " + at_index(l2, 0, string));
            +score("Agent"+i , 0);
            system.createAgent("Agent"+i, at_index(l2, 0, string));
            system.setMainGoal("Agent"+i, [game_url]);
            i++;
        }


        if(agentSelection(string a1, string a2))
        {
            +currentAgents(a1, a2);
        }
        

        system.sleep(2000);
        
        !game();
    }

    rule +!game() : api_index_url(string game_url) {
        //TODO Part 2
        knowledgeStore.getKnowledge("http://localhost:8083/players", "JSON-LD");

    }

    rule $knowledgeStore.read(string url) : strings.endsWith(url, "players") {
        ///TODO Part 2
        boolean type = false;
        int c = m.randomInt();
        if(c%2 == 0)
        {
            type = true;
        }
        if(currentAgents(string a1, string a2))
        {
            console.println(" "); // create a blank line
            console.println("Match between players: " + a1 + " and " + a2 );
        }
        
        foreach(ttt.Agent(url, string agent_url) & currentAgents(string a1, string a2) & (strings.contains(agent_url, a1) | strings.contains(agent_url, a2))){
            if(type)
            {
                +player(OPlayerRole, agent_url);
                type = false;
            }
            else {
                +player(XPlayerRole, agent_url);
                type = true;
            }
        }
        // knowledgeStore.displayModel();
        !form_actions(url);
    }

    rule +form_actions(string form_url, string http_method, list required_actions) : strings.endsWith(form_url, "registerGame") {
        //TODO Part 2
        
        JsonNode bodyJson = builder.createObject();
        forall(string item : required_actions) 
        {
            if (strings.equal(item, "ttt:OPlayerRole")& player(OPlayerRole, string playerURL)) 
            {
                builder.addProperty(bodyJson, item, playerURL);
            }

            if (strings.equal(item, "ttt:XPlayerRole")& player(XPlayerRole, string playerURL)) 
            {
                builder.addProperty(bodyJson, item, playerURL);
            }
        }
        string bodyStr = builder.toJsonString(bodyJson);
        MAMSAgent::!post(form_url, bodyStr, HttpResponse response);
        !clear_knowledge();
        knowledgeStore.getKnowledgeFromString(httpUtils.bodyAsString(response), form_url);
    }        
    
    rule $knowledgeStore.read(string url) : strings.endsWith(url, "registerGame") {
        //TODO Part 2
        if (ttt.hasID(url, string gameID)) {
            console.println("Game ID is " + gameID + " url: " + url);
            if(player(OPlayerRole, string agentURL) & player(XPlayerRole, string XagentURL))
            {
                send(inform, agentURL, game(gameID, OPlayerRole, XagentURL));
                send(inform, XagentURL, game(gameID, XPlayerRole, agentURL));
            }
            // send(inform, <agent_url>, game(gameID, <agent_role>, <opponent_url>));
        }
    }

    /**
     * Means-end reasoning
     * GOAL: !clear_knowledge
     * This keeps things HATEOAS-y, i.e. each response from the API contains all the information the agent needs to 
     * play a game; so the links, forms and knowledge store should be cleared down in between API calls
     * to reflect this (and avoid situations where the agent may think it has actions available to it which are no longer valid)
     */
     rule +!clear_knowledge() {
        knowledgeStore.clear();
        //Clear down ALL form action and link action beliefs
        foreach(form_actions(string anyForm, string method_name, list any_list)) {
            -form_actions(anyForm, method_name, any_list);
        }
        foreach(link_actions(string anyLink)) {
            -link_actions(anyLink);
        }
    }

    rule @message(inform, string sender, winner(string winnerRole)) {
        
        // -+winner(url);
        if(player(winnerRole, string winnerURL))
        {
            string st1 = at_index(strings.split(winnerURL, "Agent"), 1, string);
            if(score("Agent" + st1, int sc))
            {
                console.println("Winner: " + winnerRole + " Agent"+st1);
                -score("Agent" + st1, sc);
                +score("Agent" + st1, sc + 1);
            }
            
        }
        else{
            console.println("Draw");
        }
        !clear_knowledge();
        foreach (player(string role, string agent_url)) {
            -player(role, agent_url);
        }
        if(currentAgents(string a1, string a2))
        {
            -agentSelection(a1, a2);
            -currentAgents(a1, a2);
        }
        if(agentSelection(string a1, string a2))
        {
            +currentAgents(a1, a2);
            system.sleep(2000);
        
            !game();
        }
        else{
            !getScore();
        }
        console.println("GAME OVER");
        
    }

    rule +!getScore()
    {
        console.println(" "); // blank space
        foreach(score(string agentname, int sc))
        {
            console.println(agentname + " has scored " + sc + " points!");
        }
    }



    rule +!shuffle(list in, list out, int N) {
        out = in;
        int i=0;
        while (i < N) {
            int j = m.randomInt() % prelude.size(out);
            int k = m.randomInt() % prelude.size(out);
            prelude.swap(out, j, k);
            i = i + 1;
        }
    }

}